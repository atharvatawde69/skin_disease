# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.db

# Virtual environment
venv/
.env/

# PyTorch / model checkpoints
*.pt
*.pth

# Dataset and training outputs (large, regenerated by the notebook)
data/
outputs/
.ipynb_checkpoints/
Screenshot*.png

# College report (contains student names/IDs, keep it out of the public repo)
*.docx
~$*

# System files
.DS_Store
Thumbs.db

# Report: PDF previews and generated helper files (the .docx is already ignored above)
report/*.pdf
report/page_numbers.json
report/labels.json

# Presentation: template copies, renders and the deck itself (the deck will hold names and the SDG)
*.ppt
*.pptx
report/ppt_template/
report/ppt_render/
